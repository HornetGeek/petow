msgid "Please correct the highlighted fields."
msgstr "يرجى تصحيح الحقول المحددة."
msgid "A device identifier is required."
msgstr "معرّف الجهاز مطلوب."
msgid "Notifications were disabled for this device."
msgstr "تم إيقاف الإشعارات لهذا الجهاز."
msgid "FCM token is required."
msgstr "رمز الإشعارات مطلوب."
msgid "The selected language is not supported."
msgstr "اللغة المحددة غير مدعومة."
msgid "Notification device updated successfully."
msgstr "تم تحديث جهاز الإشعارات بنجاح."
msgid "Could not update the notification device."
msgstr "تعذر تحديث جهاز الإشعارات."
msgid "Your account was deleted successfully."
msgstr "تم حذف حسابك بنجاح."
msgid "Email and password are required."
msgstr "البريد الإلكتروني وكلمة المرور مطلوبان."
msgid "The email or password is incorrect."
msgstr "بيانات تسجيل الدخول غير صحيحة."
msgid "Account created successfully."
msgstr "تم إنشاء الحساب بنجاح."
msgid "Could not create the account."
msgstr "تعذر إنشاء الحساب."
msgid "Google token is required."
msgstr "رمز Google مطلوب."
msgid "The Google token is invalid or expired."
msgstr "رمز Google غير صالح أو منتهي الصلاحية."
msgid "The Google account does not provide an email address."
msgstr "حساب Google لا يحتوي على بريد إلكتروني."
msgid "You were logged out successfully."
msgstr "تم تسجيل الخروج بنجاح."
msgid "Could not log out."
msgstr "تعذر تسجيل الخروج."
msgid "Email is required."
msgstr "البريد الإلكتروني مطلوب."
msgid "If the email exists, a verification code will be sent."
msgstr "إذا كان البريد الإلكتروني موجودًا، فسيتم إرسال كود التحقق."
msgid "Email and verification code are required."
msgstr "البريد الإلكتروني وكود التحقق مطلوبان."
msgid "The verification code is incorrect."
msgstr "كود التحقق غير صحيح."
msgid "The verification code has expired."
msgstr "انتهت صلاحية كود التحقق."
msgid "The verification code was confirmed successfully."
msgstr "تم التحقق من الكود بنجاح."
msgid "The email address was not found."
msgstr "البريد الإلكتروني غير موجود."
msgid "Could not verify the code."
msgstr "تعذر التحقق من الكود."
msgid "All fields are required."
msgstr "جميع الحقول مطلوبة."
msgid "Passwords do not match."
msgstr "كلمتا المرور غير متطابقتين."
msgid "Password must contain at least 8 characters."
msgstr "يجب أن تتكون كلمة المرور من 8 أحرف على الأقل."
msgid "The password reset session has expired."
msgstr "انتهت صلاحية جلسة إعادة تعيين كلمة المرور."
msgid "Password changed successfully."
msgstr "تم تغيير كلمة المرور بنجاح."
msgid "The password reset token is invalid."
msgstr "رمز إعادة تعيين كلمة المرور غير صالح."
msgid "Could not change the password."
msgstr "تعذر تغيير كلمة المرور."

